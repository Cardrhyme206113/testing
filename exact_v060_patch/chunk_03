+        private int[] indices = new int[6 * 65536];
+        private int vertexCount;
+        private int indexCount;
+
+        private int[] keyX = new int[1 << 18];
+        private int[] keyY = new int[1 << 18];
+        private int[] keyZ = new int[1 << 18];
+        private int[] values = new int[1 << 18]; // index + 1, zero = empty
+        private int mask = values.length - 1;
+        private int tableSize;
+
+        private float minX = Float.POSITIVE_INFINITY, minY = Float.POSITIVE_INFINITY, minZ = Float.POSITIVE_INFINITY;
