+            double cx=aby*acz-abz*acy, cy=abz*acx-abx*acz, cz=abx*acy-aby*acx;
+            if (cx*cx + cy*cy + cz*cz < 1.0e-16) return;
+            ensureIndices(indexCount + 3);
+            indices[indexCount++] = a;
+            indices[indexCount++] = b;
+            indices[indexCount++] = c;
+        }
+
+        private void ensurePositions(int count) {
+            int need = count * 3;
+            if (need > positions.length) positions = Arrays.copyOf(positions, Math.max(need, positions.length << 1));
+        }
+        private void ensureIndices(int count) {
+            if (count > indices.length) indices = Arrays.copyOf(indices, Math.max(count, indices.length << 1));
+        }
+
+        private void rehash(int capacity) {
+            int[] ox=keyX, oy=keyY, oz=keyZ, ov=values;
+            keyX=new int[capacity]; keyY=new int[capacity]; keyZ=new int[capacity]; values=new int[capacity];
+            mask=capacity-1; tableSize=0;
+            for (int i=0;i<ov.length;i++) if (ov[i]!=0) {
+                int slot=mix(ox[i],oy[i],oz[i]) & mask;
+                while(values[slot]!=0) slot=(slot+1)&mask;
+                keyX[slot]=ox[i]; keyY[slot]=oy[i]; keyZ[slot]=oz[i]; values[slot]=ov[i]; tableSize++;
+            }
+        }
+
+        private static int mix(int x, int y, int z) {
+            int h = x * 0x9E3779B9;
+            h ^= Integer.rotateLeft(y * 0x85EBCA6B, 11);
+            h ^= Integer.rotateLeft(z * 0xC2B2AE35, 22);
+            h ^= h >>> 16;
+            h *= 0x7FEB352D;
+            h ^= h >>> 15;
+            return h;
+        }
+
+        float minX(){return vertexCount==0?0:minX;} float minY(){return vertexCount==0?0:minY;} float minZ(){return vertexCount==0?0:minZ;}
+        float maxX(){return vertexCount==0?0:maxX;} float maxY(){return vertexCount==0?0:maxY;} float maxZ(){return vertexCount==0?0:maxZ;}
+    }
+
+    private static void writeIntLE(OutputStream out, int v) throws IOException {
+        out.write(v); out.write(v >>> 8); out.write(v >>> 16); out.write(v >>> 24);
+    }
+    private static void writeFloatLE(OutputStream out, float v) throws IOException { writeIntLE(out, Float.floatToIntBits(v)); }
+    private static void writeDoubleLE(OutputStream out, double v) throws IOException {
+        long x = Double.doubleToLongBits(v);
+        out.write((int)x); out.write((int)(x>>>8)); out.write((int)(x>>>16)); out.write((int)(x>>>24));
+        out.write((int)(x>>>32)); out.write((int)(x>>>40)); out.write((int)(x>>>48)); out.write((int)(x>>>56));
+    }
+    private static String json(String s) { return s == null ? "null" : "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""; }
+    private static String fmt(double v) { return String.format(Locale.ROOT, "%.9g", v); }
+}
