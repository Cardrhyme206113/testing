+            positions[p] = x; positions[p + 1] = y; positions[p + 2] = z;
+            minX = Math.min(minX, x); minY = Math.min(minY, y); minZ = Math.min(minZ, z);
+            maxX = Math.max(maxX, x); maxY = Math.max(maxY, y); maxZ = Math.max(maxZ, z);
+            keyX[slot] = xb; keyY[slot] = yb; keyZ[slot] = zb; values[slot] = index + 1;
+            tableSize++;
+            return index;
+        }
+
+        void triangle(int a, int b, int c) {
+            if (a < 0 || b < 0 || c < 0 || a == b || b == c || a == c) return;
+            // Reject mathematically degenerate position-only triangles. They have no raster area.
+            int pa=a*3, pb=b*3, pc=c*3;
+            double abx=positions[pb]-positions[pa], aby=positions[pb+1]-positions[pa+1], abz=positions[pb+2]-positions[pa+2];
