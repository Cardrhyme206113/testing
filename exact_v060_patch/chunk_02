+    private Result write(Path sessionDir) throws IOException {
+        Path geometryDir = sessionDir.resolve("geometry");
+        Files.createDirectories(geometryDir);
+        Path file = geometryDir.resolve("scene.pgeo.gz");
+
+        long rawBytes = 8L + 4L + 4L + 4L + 24L + 24L + 4L
+                + (long) mesh.vertexCount * 12L + (long) mesh.indexCount * 4L;
+        try (OutputStream raw = Files.newOutputStream(file);
+             OutputStream buffered = new BufferedOutputStream(raw, 1 << 20);
+             GZIPOutputStream gz = new GZIPOutputStream(buffered, 1 << 20)) {
+            gz.write(MAGIC);
+            writeIntLE(gz, FORMAT_VERSION);
+            writeIntLE(gz, mesh.vertexCount);
+            writeIntLE(gz, mesh.indexCount);
+            writeDoubleLE(gz, originX);
+            writeDoubleLE(gz, originY);
+            writeDoubleLE(gz, originZ);
+            writeFloatLE(gz, mesh.minX()); writeFloatLE(gz, mesh.minY()); writeFloatLE(gz, mesh.minZ());
+            writeFloatLE(gz, mesh.maxX()); writeFloatLE(gz, mesh.maxY()); writeFloatLE(gz, mesh.maxZ());
+            writeIntLE(gz, 0); // reserved flags
+            for (int i = 0; i < mesh.vertexCount * 3; i++) writeFloatLE(gz, mesh.positions[i]);
+            for (int i = 0; i < mesh.indexCount; i++) writeIntLE(gz, mesh.indices[i]);
+        }
+
+        long compressedBytes = Files.size(file);
+        Result result = new Result(
+                "geometry/scene.pgeo.gz", mesh.vertexCount, mesh.indexCount / 3,
+                rawBytes, compressedBytes, chunksVisited, blocksVisited, blocksRendered,
+                blockEntitiesRendered, entitiesRendered, rangeBlocks, 180.0,
+                originX, originY, originZ,
+                mesh.minX(), mesh.minY(), mesh.minZ(), mesh.maxX(), mesh.maxY(), mesh.maxZ()
+        );
+        Files.writeString(geometryDir.resolve("manifest.json"), result.toJson() + "\n", StandardCharsets.UTF_8);
+        return result;
+    }
