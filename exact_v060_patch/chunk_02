+    /** Routes each render layer to a position-only primitive collector. */
+    private static final class GeometryProvider implements VertexConsumerProvider {
+        private final MeshBuilder mesh;
+        private final Map<RenderLayer, PrimitiveConsumer> streams = new IdentityHashMap<>();
+
+        private GeometryProvider(MeshBuilder mesh) { this.mesh = mesh; }
