+    private ExactGeometryExporter(MinecraftClient client, CaptureConfig cfg,
+                                  double originX, double originY, double originZ,
+                                  float yaw) {
+        this.client = client;
+        this.cfg = cfg;
+        this.originX = originX;
+        this.originY = originY;
+        this.originZ = originZ;
+        this.baseYaw = yaw;
+
+        double yr = Math.toRadians(yaw);
+        this.forwardX = -Math.sin(yr);
+        this.forwardZ = Math.cos(yr);
+        double autoRange = client.options.getViewDistance().getValue() * 16.0 + 32.0;
+        this.rangeBlocks = cfg.exactGeometryRangeBlocks > 0.0 ? cfg.exactGeometryRangeBlocks : autoRange;
+        this.rangeSq = rangeBlocks * rangeBlocks;
+        this.guardBlocks = Math.max(4.0, cfg.gridRadius * cfg.offsetStepBlocks + cfg.exactGeometryGuardBlocks);
+    }
