+        @Override
+        public VertexConsumer getBuffer(RenderLayer layer) {
+            return streams.computeIfAbsent(layer, l ->
+                    new PrimitiveConsumer(mesh, l.getDrawMode(), 0.0, 0.0, 0.0));
