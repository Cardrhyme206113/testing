+    public static Result export(MinecraftClient client, CaptureConfig cfg, Path sessionDir,
+                                double originX, double originY, double originZ,
+                                float yaw) throws IOException {
+        if (client.world == null) throw new IllegalStateException("World disappeared during geometry export");
+        ExactGeometryExporter exporter = new ExactGeometryExporter(client, cfg, originX, originY, originZ, yaw);
+        exporter.captureBlocksAndBlockEntities();
+        exporter.captureEntities();
+        return exporter.write(sessionDir);
+    }
+
+    private void captureBlocksAndBlockEntities() {
+        BlockRenderManager blocks = client.getBlockRenderManager();
+        int centerChunkX = MathHelper.floor(originX) >> 4;
+        int centerChunkZ = MathHelper.floor(originZ) >> 4;
+        int radiusChunks = MathHelper.ceil((rangeBlocks + 24.0) / 16.0);
+
+        for (int cz = centerChunkZ - radiusChunks; cz <= centerChunkZ + radiusChunks; cz++) {
+            for (int cx = centerChunkX - radiusChunks; cx <= centerChunkX + radiusChunks; cx++) {
+                if (!chunkCouldMatter(cx, cz)) continue;
+                Chunk chunkBase = client.world.getChunk(cx, cz, ChunkStatus.FULL, false);
+                if (!(chunkBase instanceof WorldChunk chunk) || chunk instanceof EmptyChunk) continue;
+                chunksVisited++;
+
+                ChunkSection[] sections = chunk.getSectionArray();
+                for (int si = 0; si < sections.length; si++) {
+                    ChunkSection section = sections[si];
+                    if (section == null || section.isEmpty()) continue;
+                    int sectionY = client.world.sectionIndexToCoord(si) << 4;
+                    captureSection(blocks, chunk, section, cx, cz, sectionY);
+                }
+
+                for (BlockEntity blockEntity : chunk.getBlockEntities().values()) {
+                    if (blockEntity == null || !pointCouldMatter(
+                            blockEntity.getPos().getX() + 0.5,
+                            blockEntity.getPos().getZ() + 0.5,
+                            2.0)) continue;
+                    captureBlockEntity(blockEntity);
+                }
+            }
+        }
+    }
+
+    private void captureSection(BlockRenderManager renderer, WorldChunk chunk, ChunkSection section,
+                                int chunkX, int chunkZ, int sectionY) {
+        int wx0 = chunkX << 4;
+        int wz0 = chunkZ << 4;
+        BlockPos.Mutable pos = new BlockPos.Mutable();
+
+        for (int ly = 0; ly < 16; ly++) {
+            int wy = sectionY + ly;
+            for (int lz = 0; lz < 16; lz++) {
+                int wz = wz0 + lz;
+                for (int lx = 0; lx < 16; lx++) {
+                    BlockState state = section.getBlockState(lx, ly, lz);
+                    FluidState fluid = section.getFluidState(lx, ly, lz);
+                    if (state.isAir() && fluid.isEmpty()) continue;
+                    blocksVisited++;
+
+                    int wx = wx0 + lx;
+                    if (!pointCouldMatter(wx + 0.5, wz + 0.5, 1.5)) continue;
+                    pos.set(wx, wy, wz);
+
+                    // Fully buried opaque cubes have no visible triangles in Minecraft's chunk mesh.
+                    // Skipping them avoids invoking the model renderer for the overwhelming majority
+                    // of underground/interior blocks without changing visible geometry.
+                    if (fluid.isEmpty() && state.isOpaqueFullCube(client.world, pos) && isBuriedOpaque(pos)) {
+                        continue;
+                    }
+
+                    try {
+                        if (state.getRenderType() == BlockRenderType.MODEL) {
+                            MatrixStack matrices = new MatrixStack();
+                            matrices.translate(wx - originX, wy - originY, wz - originZ);
+                            PrimitiveConsumer out = new PrimitiveConsumer(mesh, VertexFormat.DrawMode.QUADS, 0.0, 0.0, 0.0);
+                            renderer.renderBlock(
+                                    state, pos, client.world, matrices, out, true,
+                                    Random.create(state.getRenderingSeed(pos))
+                            );
+                            blocksRendered++;
+                        }
+                        if (!fluid.isEmpty()) {
+                            // FluidRenderer emits world-space coordinates, so this consumer subtracts
+                            // the capture origin directly rather than relying on a MatrixStack.
+                            PrimitiveConsumer fluidOut = new PrimitiveConsumer(
+                                    mesh, VertexFormat.DrawMode.QUADS, -originX, -originY, -originZ
+                            );
+                            renderer.renderFluid(pos, client.world, fluidOut, state, fluid);
+                        }
+                    } catch (Throwable t) {
+                        // One broken/custom model must not destroy a whole scene export.
+                        ParallaxCaptureClient.LOGGER.debug("Geometry: block renderer failed at {}", pos, t);
+                    }
+                }
+            }
+        }
+    }
+
+    private boolean isBuriedOpaque(BlockPos pos) {
+        for (Direction direction : DIRECTIONS) {
+            BlockPos n = pos.offset(direction);
+            BlockState s = client.world.getBlockState(n);
+            if (!s.isOpaqueFullCube(client.world, n)) return false;
+        }
+        return true;
+    }
+
+    private void captureBlockEntity(BlockEntity blockEntity) {
+        BlockEntityRenderDispatcher dispatcher = client.getBlockEntityRenderDispatcher();
+        if (dispatcher.get(blockEntity) == null) return;
+        try {
+            MatrixStack matrices = new MatrixStack();
+            BlockPos p = blockEntity.getPos();
+            matrices.translate(p.getX() - originX, p.getY() - originY, p.getZ() - originZ);
+            GeometryProvider provider = new GeometryProvider(mesh);
+            dispatcher.render(blockEntity, client.getTickDelta(), matrices, provider);
+            provider.finish();
+            blockEntitiesRendered++;
+        } catch (Throwable t) {
+            ParallaxCaptureClient.LOGGER.debug("Geometry: block entity renderer failed at {}", blockEntity.getPos(), t);
+        }
+    }
+
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    private void captureEntities() {
+        EntityRenderDispatcher dispatcher = client.getEntityRenderDispatcher();
+        float tickDelta = client.getTickDelta();
+        for (Entity entity : client.world.getEntities()) {
+            if (CaptureContentFilter.suppressEntity(entity)) continue;
+
+            double ex = MathHelper.lerp(tickDelta, entity.lastRenderX, entity.getX());
+            double ey = MathHelper.lerp(tickDelta, entity.lastRenderY, entity.getY());
+            double ez = MathHelper.lerp(tickDelta, entity.lastRenderZ, entity.getZ());
+            if (!pointCouldMatter(ex, ez, Math.max(2.0, entity.getWidth() + 2.0))) continue;
+
+            try {
+                EntityRenderer renderer = dispatcher.getRenderer(entity);
+                if (renderer == null) continue;
+                MatrixStack matrices = new MatrixStack();
+                matrices.translate(ex - originX, ey - originY, ez - originZ);
+                GeometryProvider provider = new GeometryProvider(mesh);
+                float yaw = MathHelper.lerp(tickDelta, entity.prevYaw, entity.getYaw());
+                int light = dispatcher.getLight(entity, tickDelta);
+                renderer.render(entity, yaw, tickDelta, matrices, provider, light);
+                provider.finish();
+                entitiesRendered++;
+            } catch (Throwable t) {
+                ParallaxCaptureClient.LOGGER.debug("Geometry: entity renderer failed for {}", entity.getType(), t);
+            }
+        }
+    }
+
+    /** 180-degree frontal half-space plus a near-camera guard band and range sphere. */
+    private boolean pointCouldMatter(double x, double z, double radius) {
+        double dx = x - originX;
+        double dz = z - originZ;
+        if (dx * dx + dz * dz > (rangeBlocks + radius) * (rangeBlocks + radius)) return false;
+        double front = dx * forwardX + dz * forwardZ;
+        return front >= -(guardBlocks + radius);
+    }
+
+    private boolean chunkCouldMatter(int cx, int cz) {
+        double x = (cx << 4) + 8.0;
+        double z = (cz << 4) + 8.0;
+        return pointCouldMatter(x, z, 12.0);
+    }
