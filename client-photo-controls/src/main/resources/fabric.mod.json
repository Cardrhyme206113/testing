{
  "schemaVersion": 1,
  "id": "client_photo_controls",
  "version": "${version}",
  "name": "Client Photo Controls",
  "description": "Client-side time and weather controls for screenshots, integrated into Sodium's Video Settings.",
  "authors": ["Cardrhyme206113"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.cardrhyme.cinecontrols.CineControlsClient"
    ],
    "sodium:config_api_user": [
      "dev.cardrhyme.cinecontrols.SodiumPhotoConfig"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "sodium": ">=0.9.1"
  }
}
