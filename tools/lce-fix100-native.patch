+
+// Native wheel routing: only remap wheel to directional slider input when
+// the focused Common/UI element is a real UIControl_Slider. No DOM hitboxes.
+extern "C" int lce_web_ui_focused_control_is_slider()
+{
+    UIScene *scene = ui.GetTopScene(0);
+    if (!scene || !scene->hasFocus(0)) return 0;
+    const int focused = scene->getControlFocus();
+    const std::vector<UIControl *> *controls = scene->GetControls();
+    if (!controls) return 0;
+    for (UIControl *control : *controls)
+    {
+        if (control && control->getId() == focused &&
+            control->getControlType() == UIControl::eSlider && control->getVisible())
+            return 1;
+    }
+    return 0;
+}
 
