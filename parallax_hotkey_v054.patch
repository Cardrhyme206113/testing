+    private static void pollCaptureHotkey() {
+        MinecraftClient client = MinecraftClient.getInstance();
+        if (client == null || client.getWindow() == null) return;
+
+        // ReplayMod rebuilds Minecraft's contextual keybinding tables while a replay
+        // is open, which can prevent Fabric KeyBinding#wasPressed from ever seeing
+        // our F8 event. Poll the physical GLFW key as a fallback from the render
+        // loop, which ReplayMod cannot remove from a keybinding registry.
+        boolean bindingPressed = false;
+        while (CAPTURE_KEY.wasPressed()) bindingPressed = true;
+
+        boolean rawDown = InputUtil.isKeyPressed(client.getWindow().getHandle(), GLFW.GLFW_KEY_F8);
+        boolean rawPressed = rawDown && !rawF8WasDown;
+        rawF8WasDown = rawDown;
+
+        if (bindingPressed || rawPressed) {
+            toggleCapture(client);
+        }
+    }
+
+    private static void toggleCapture(MinecraftClient client) {
+        if (session != null && !session.isDone()) {
+            session.cancel();
+        } else {
+            start(client);
+        }
+    }
